# ═════════════════════════════════════════════════════════════
# .env (RAÍZ) — plantilla. Copiar:  cp .env.example .env
# ═════════════════════════════════════════════════════════════
# Este archivo lo lee SOLO docker-compose (Postgres y Piston).
# El proyecto tiene 3 archivos .env, uno por proceso:
#
#   .env               ← ESTE (docker-compose: base de datos)
#   apps/api/.env      ← la API NestJS   (ver apps/api/.env.example)
#   apps/web/.env      ← el frontend Vite (ver apps/web/.env.example)
#
# ── Arranque desde cero (máquina limpia) ─────────────────────
#   cp .env.example .env
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env
#   make setup    # instala deps + levanta Postgres + migra + seed
#   make dev      # levanta web (5173) + api (4000)
#
# Para staging/producción ver docs/DEPLOYMENT.md (Railway).
# ═════════════════════════════════════════════════════════════

# ── Postgres (contenedor docker-compose) ─────────────────────
# Definen el contenedor de la base. DEBEN coincidir con el
# DATABASE_URL de apps/api/.env (mismo user/password/db/puerto),
# o la API no podrá conectarse a la base.
POSTGRES_USER=nexott
POSTGRES_PASSWORD=nexott_dev
POSTGRES_DB=nexott_learn
# Puerto expuesto en el host. Dentro del contenedor siempre es 5432.
POSTGRES_PORT=5435

# ── Piston (sandbox de ejecución de código) — OPCIONAL ───────
# Solo si usas `make sandbox-up` (ejecutar código de ejercicios).
# Puerto HTTP del sandbox en el host.
PISTON_PORT=2000

# ═════════════════════════════════════════════════════════════
# apps/web/.env — plantilla. Copiar:  cp apps/web/.env.example apps/web/.env
# ═════════════════════════════════════════════════════════════
# Lo lee Vite. SOLO las variables con prefijo VITE_ llegan al
# navegador (Vite las inyecta en el bundle del frontend).
# ═════════════════════════════════════════════════════════════

# Modo de datos del frontend:
#   false → pega al backend REAL (usuarios del seed). Úsalo con `make dev`.
#   true  → usa datos MOCK (MSW) sin backend. Útil para maquetar UI sola.
#
# OJO: si NO defines esta variable, el default interno del código es
# `true` (mock). Es decir: SIN esta línea no verás datos reales aunque
# el backend esté corriendo. Por eso la dejamos explícita en false.
VITE_USE_MOCKS=false

# ── VITE_API_URL — NO la definas en desarrollo ───────────────
# En dev el front usa "/api/v1" por defecto y el proxy de Vite
# redirige /api → http://localhost:4000. Si defines VITE_API_URL
# (p. ej. http://localhost:4000), las llamadas pierden el prefijo
# /api/v1 y responden 404. Déjala comentada en local.
#
# Solo se usa en el BUILD de producción, y ahí debe incluir el
# prefijo, p. ej.: https://api.tu-dominio.tld/api/v1
# VITE_API_URL=
